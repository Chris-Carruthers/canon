# canon-slack — copy to .env and fill in. .env is gitignored; never commit tokens.

# ── Slack app credentials ────────────────────────────────────────────────────
# Bot User OAuth Token — Slack app → OAuth & Permissions (starts xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token with connections:write — Slack app → Basic Information (xapp-)
SLACK_APP_TOKEN=

# ── Anthropic ────────────────────────────────────────────────────────────────
# The agent needs model access. Omit if the host is already authenticated.
ANTHROPIC_API_KEY=

# ── Who may ask (REQUIRED — the bot refuses to start without one) ────────────
# This connector bypasses git permissions: git decides who can clone the vault,
# Slack decides who is in the channel. If those differ, an open bot is a leak.
#
# Channel IDs (not names) — right-click a channel → View channel details → bottom.
CANON_SLACK_ALLOW_CHANNELS=
# Slack user IDs — profile → More → Copy member ID.
CANON_SLACK_ALLOW_USERS=
#
# Use '*' ONLY if every member of the workspace may read every note in the vault:
# CANON_SLACK_ALLOW_CHANNELS=*

# ── Optional ─────────────────────────────────────────────────────────────────
# Vault location. Omit to use canon-path (CANON_HOME → .canon → ~/.config/canon/path).
# CANON_HOME=~/team-vault
# CANON_SLACK_MODEL=claude-sonnet-5
# CANON_ROUTER=Vision/Agent Router.md
# CANON_SLACK_MAX_TURNS=24
# CANON_SLACK_STORE=/var/tmp/canon-slack-threads.json
# CANON_SLACK_DEBUG=1
