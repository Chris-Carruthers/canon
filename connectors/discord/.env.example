# canon-discord — copy to .env and fill in. .env is gitignored; never commit tokens.

# ── Discord app credentials (discord.com/developers/applications) ────────────
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Register /canon in one server (appears instantly). Leave blank to register
# globally, which can take up to an hour to propagate.
DISCORD_GUILD_ID=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Who may ask (REQUIRED — the bot refuses to start without one) ────────────
# This connector bypasses git permissions: git decides who can clone the vault,
# Discord decides who is in the server. Discord servers are usually BROADER than a
# work chat, so be stricter here, not looser.
# Enable Developer Mode in Discord to copy IDs (right-click → Copy ID).
CANON_DISCORD_ALLOW_CHANNELS=
CANON_DISCORD_ALLOW_ROLES=
CANON_DISCORD_ALLOW_USERS=
#
# Use '*' ONLY if everyone who can reach this bot may read every note:
# CANON_DISCORD_ALLOW_CHANNELS=*

# ── Optional ─────────────────────────────────────────────────────────────────
# Answer @mentions as well as /canon. Requires the PRIVILEGED MessageContent
# intent, which means the bot can see all message text in the server. Off by
# default: the slash command gives the same feature with less privilege.
# CANON_DISCORD_ALLOW_MENTIONS=1
#
# CANON_HOME=~/team-vault
# CANON_DISCORD_MODEL=claude-sonnet-5
# CANON_ROUTER=Vision/Agent Router.md
# CANON_DISCORD_MAX_TURNS=24
