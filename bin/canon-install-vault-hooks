#!/usr/bin/env bash
# canon-install-vault-hooks — put the scanner in front of every commit to the
# vault, not just the ones made through canon-sync.
#
#   canon-install-vault-hooks [/path/to/vault]
#
# Installs .git/hooks/pre-commit in the vault repo. Any tool that shells out to
# real git — the CLI, canon-sync, most editors — will hit the gate.
#
# COVERAGE, precisely — this matters if you are relying on the gate:
#   * The git CLI, canon-sync, and most editors shell out to real git: covered.
#   * Obsidian Git on DESKTOP uses simple-git, which spawns the git binary, so
#     its commits ARE covered. (Verified from the plugin's own source and its
#     issue #1055, where a global hook fired during a plugin push.)
#   * Obsidian Git on MOBILE uses isomorphic-git, which does NOT run hooks — a
#     plugin cannot use native git on Android or iOS. Mobile writes are UNGATED.
#   * .git/hooks is not shared by cloning, so every teammate must run this once.
# The only gate nobody can skip is your host's server-side push protection.
# Turn it on; treat this hook as the early, friendly layer.

set -euo pipefail

CANON_VERSION="0.1.0"
case "${1:-}" in --version|-V) printf 'canon %s\n' "$CANON_VERSION"; exit 0 ;; esac


HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VAULT="${1:-}"
if [ -z "$VAULT" ]; then
  RESOLVER="$HERE/canon-path"
  [ -x "$RESOLVER" ] || RESOLVER="$(command -v canon-path 2>/dev/null || true)"
  [ -n "$RESOLVER" ] && VAULT="$("$RESOLVER" 2>/dev/null || true)"
fi
[ -n "$VAULT" ] || { echo "usage: canon-install-vault-hooks /path/to/vault" >&2; exit 2; }
[ -d "$VAULT/.git" ] || { echo "error: not a git repo: $VAULT" >&2; exit 2; }
VAULT="$(cd "$VAULT" && pwd)"

# Ship the scanner inside the vault repo so the hook has no external dependency
# and keeps working on a fresh clone.
# Tolerate being run FROM the vault's own .canon/ — a vault that carries these
# scripts can bootstrap itself on a fresh clone with no other checkout, which is
# the only way onboarding works for someone who doesn't have this kit.
mkdir -p "$VAULT/.canon"
for tool in canon-scan canon-guard; do
  src="$HERE/$tool"; dst="$VAULT/.canon/$tool"
  [ -f "$src" ] || continue
  if [ "$(cd "$(dirname "$src")" && pwd)/$tool" != "$(cd "$(dirname "$dst")" && pwd)/$tool" ]; then
    cp "$src" "$dst"
  fi
  chmod +x "$dst"
done

# WHERE do hooks actually live? If core.hooksPath is set — husky, the pre-commit
# framework, a shared team hooks dir — git ignores .git/hooks COMPLETELY. Writing
# there would install a gate git never looks at: silently inert, which is worse
# than no gate at all because you believe you are covered.
HOOKS_DIR="$(git -C "$VAULT" config core.hooksPath 2>/dev/null || true)"
if [ -n "$HOOKS_DIR" ]; then
  case "$HOOKS_DIR" in
    /*) : ;;                                  # absolute, use as-is
    *)  HOOKS_DIR="$VAULT/$HOOKS_DIR" ;;      # relative to the repo
  esac
  echo "  note: core.hooksPath is set — installing into $HOOKS_DIR"
  echo "        (git ignores .git/hooks entirely when it is set)"
  mkdir -p "$HOOKS_DIR"
else
  HOOKS_DIR="$VAULT/.git/hooks"
fi

HOOK="$HOOKS_DIR/pre-commit"
CHAINED="$HOOKS_DIR/pre-commit.canon-chained"

# An existing pre-commit is somebody's working check — a spec validator, a
# formatter, a linter. Backing it up and replacing it silently disables it, which
# is exactly the clobbering this kit refuses to do elsewhere. So we CHAIN: move it
# aside and call it first from ours. If it fails, we stop and never reach our own
# checks, which is the correct precedence for a check the repo already had.
#
# No separate .bak: moving it to .canon-chained already preserves it byte for
# byte, and it stays in use. A timestamped duplicate alongside it is just a
# second identical file in a hooks directory, which invites confusion about
# which one git actually runs.
if [ -f "$HOOK" ] && ! grep -q 'canon-scan' "$HOOK" 2>/dev/null; then
  if [ -e "$CHAINED" ]; then
    # Already chained something; do not overwrite that with our own hook.
    echo "  warning: $CHAINED already exists — leaving it alone" >&2
    echo "           inspect both before relying on the chain" >&2
  else
    mv "$HOOK" "$CHAINED"
    chmod +x "$CHAINED"
    echo "  existing pre-commit preserved as pre-commit.canon-chained (runs first)"
  fi
fi

cat > "$HOOK" <<'EOF'
#!/usr/bin/env bash
# Installed by canon-install-vault-hooks. Two checks before a vault commit:
#   canon-scan   — credentials / obvious identifiers (blocks)
#   canon-guard  — governed paths you do not own (warns by default)
#
# Bypass (be sure):  git commit --no-verify
#   or per-check:    CANON_SKIP_SCAN=1  /  CANON_GUARD=off
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Whatever pre-commit check this repo had before canon was installed runs first
# and keeps its veto. We are an addition, not a replacement.
HD="$(git config core.hooksPath 2>/dev/null || true)"
if [ -n "$HD" ]; then case "$HD" in /*) : ;; *) HD="$ROOT/$HD" ;; esac; else HD="$ROOT/.git/hooks"; fi
PRIOR="$HD/pre-commit.canon-chained"
if [ -x "$PRIOR" ]; then
  "$PRIOR" "$@" || exit $?
fi

find_tool() {
  local t="$ROOT/.canon/$1"
  [ -x "$t" ] || t="$(command -v "$1" 2>/dev/null || true)"
  printf '%s' "$t"
}

# Ownership first: it is advisory, and being told "you do not own this" before
# being told "this looks like a secret" is the more useful order.
if [ "${CANON_GUARD:-warn}" != "off" ]; then
  GUARD="$(find_tool canon-guard)"
  if [ -n "$GUARD" ] && [ -x "$GUARD" ]; then
    "$GUARD" "$ROOT" || exit 1
  fi
fi

if [ "${CANON_SKIP_SCAN:-0}" = "1" ]; then exit 0; fi
SCAN="$(find_tool canon-scan)"
if [ -z "$SCAN" ] || [ ! -x "$SCAN" ]; then
  echo "pre-commit: canon-scan not found — allowing commit UNGATED" >&2
  exit 0
fi
exec "$SCAN" "$ROOT"
EOF
chmod +x "$HOOK"

echo "installed: $HOOK"
echo "tools:     $VAULT/.canon/{canon-scan,canon-guard}"
cat <<EOF

Note: .git/hooks is NOT shared by cloning. Each teammate must run this once:
  canon-install-vault-hooks "$VAULT"

Commit .canon/canon-scan so it travels with the repo, and consider enabling
your git host's own secret-scanning / push protection — that is the only gate
no local tool can bypass.
EOF
