#!/usr/bin/env bash
# canon-design-audit — does the code match the design canon?
#
#   canon-design-audit <repo> [<repo>...]
#
#   --vault PATH       vault to read the canon from (default: via canon-path)
#   --report           write a dated report into <vault>/Outputs/
#   --strict           exit 1 when a VIOLATION count exceeds its baseline
#   --json             machine-readable findings on stdout
#   --export           the resolved canon itself, as JSON, on stdout
#   --view             write a human-and-agent readable view into <vault>/Outputs/
#   --baseline-write   print a .canon-design-baseline for redirection
#   --quiet            counts only
#
# It reads the CONTRACT from the vault — the design-tokens, design-components and
# design-tools blocks under Reference/Design/ — and the FACTS from your code repos,
# and recomputes everything on every run. Nothing is cached in frontmatter, no
# score is stored, and there is no scorecard note to keep current.
#
# design-tools is the registry of what is approved for MAKING or FIXING UI. It is
# checked, not merely parsed: a tool whose roles write UI must name the vocabulary
# it targets, and that vocabulary must exist. A generator left to choose its own
# does not abstain — it invents one, and you meet the fifth --primary months later.
# A vault that registers no tools gets byte-identical output to a build without
# the feature; an unused registry should be invisible, not a row of zeroes.
#
# READ-ONLY in every repo it scans. The single file it ever writes is the report,
# and only with --report.
#
# WHAT IT DELIBERATELY DOES NOT DO: compare two token values.
#
# That is not an omission, it is the design. Deciding whether `var(--foreground)`
# in one file equals `222 47% 11%` in another is a CSS resolution problem —
# aliases, calc(), colour spaces, the cascade, shadow-root scoping — and a regex
# cannot solve it. A tool that tries produces confident false results, and a
# report with known-false lines in it is a report nobody reads. So this compares
# NAME SETS and FORMAT LABELS, and leaves value equivalence to the browser.
#
# Two severities, and only one can fail a build:
#   VIOLATION  a fact you can verify by opening the cited file at the cited line
#   GAP        a judgement call. Never fails anything, even with --strict.

set -uo pipefail

CANON_VERSION="0.2.0"
case "${1:-}" in --version|-V) printf 'canon %s\n' "$CANON_VERSION"; exit 0 ;; esac

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT=""; MODE="text"; DO_REPORT=0; STRICT=0; QUIET=0; BASELINE_WRITE=0; DO_VIEW=0
# An indexed array, not a newline-joined string piped on stdin: the python body
# arrives via `python3 - <<'PY'`, which IS stdin, so anything piped in is
# swallowed by the heredoc and the repo list silently arrives empty.
REPOS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --vault) VAULT="${2:-}"; shift 2 ;;
    --report) DO_REPORT=1; shift ;;
    --strict) STRICT=1; shift ;;
    --json) MODE="json"; shift ;;
    --export) MODE="export"; shift ;;
    --view) DO_VIEW=1; shift ;;
    --baseline-write) BASELINE_WRITE=1; shift ;;
    --quiet) QUIET=1; shift ;;
    -h|--help) sed -n '2,41p' "$0"; exit 0 ;;
    -*) echo "canon-design-audit: unknown option: $1" >&2; exit 2 ;;
    *) REPOS[${#REPOS[@]}]="$1"; shift ;;
  esac
done

if [ "${#REPOS[@]}" -eq 0 ]; then
  echo "canon-design-audit: name at least one repo to scan" >&2
  echo "usage: canon-design-audit [options] <repo> [<repo>...]" >&2
  exit 2
fi

# --- locate the vault --------------------------------------------------------
if [ -z "$VAULT" ]; then
  R="$HERE/canon-path"; [ -x "$R" ] || R="$(command -v canon-path 2>/dev/null || true)"
  [ -n "$R" ] && [ -x "$R" ] && VAULT="$("$R" 2>/dev/null || true)"
fi
[ -n "$VAULT" ] || { echo "canon-design-audit: no vault configured (set \$CANON_HOME or pass --vault)" >&2; exit 2; }
[ -d "$VAULT" ] || { echo "canon-design-audit: not a directory: ${VAULT}" >&2; exit 2; }

python3 - \
  "$VAULT" "$MODE" "$DO_REPORT" "$STRICT" "$QUIET" "$BASELINE_WRITE" "$CANON_VERSION" \
  "$DO_VIEW" "${REPOS[@]}" <<'PY'
import datetime, json, os, re, sys

vault, mode, do_report, strict, quiet, baseline_write, version = (
    sys.argv[1], sys.argv[2], sys.argv[3] == "1", sys.argv[4] == "1",
    sys.argv[5] == "1", sys.argv[6] == "1", sys.argv[7])
do_view = sys.argv[8] == "1"
repos = [os.path.abspath(p) for p in sys.argv[9:] if p.strip()]

# ---------------------------------------------------------------------------
# FROZEN key sets. These must match templates/vault/Templates/Design System.md.
# The kit already carries one scar from letting a template and its validator
# drift: a Product Spec template whose fence names never matched the validator
# written against it, so every file made from the template failed the check.
# ---------------------------------------------------------------------------
TOKEN_KEYS = {"vocabulary", "source", "format", "scope", "catalog", "names",
              "status", "of"}
COMP_KEYS = {"slug", "name", "vocabulary", "figma", "image", "impl", "tokens",
             "status", "note"}
TOOL_KEYS = {"slug", "name", "kind", "roles", "emits", "ingest", "values-to",
             "vocabulary", "version", "checked", "hazard", "note"}
FORMATS = {"hsl-triplet", "oklch", "hex", "rgb-triplet", "named"}
KINDS = {"vendor", "skill", "script"}
ROLES = {"generator", "critic", "implementer", "design-source", "style-guide"}
# A tool in either of these roles WRITES UI, so it must be told which vocabulary
# to target. Left to itself it does not decline to choose — it invents one.
WRITING_ROLES = {"generator", "implementer"}
# Third-party capability rots faster than anything else in this canon. Six months
# is long enough not to nag and short enough that a claim cannot quietly outlive
# the product it describes.
TOOL_STALE_DAYS = 180

# Tailwind's default palette, enumerated on purpose. A pattern like
# `bg-[a-z]+-[0-9]+` would also match bg-primary-500 and every project's own
# scale, and a rule with false positives in it is a rule people switch off.
TW_COLORS = ("slate gray zinc neutral stone red orange amber yellow lime green "
             "emerald teal cyan sky blue indigo violet purple fuchsia pink rose").split()
TW_STEPS = "50 100 200 300 400 500 600 700 800 900 950".split()
TW_PREFIX = ("bg text border ring fill stroke from to via outline decoration "
             "shadow accent caret divide placeholder").split()
RE_PALETTE = re.compile(
    r"\b(?:%s)-(?:%s)-(?:%s)\b" % ("|".join(TW_PREFIX), "|".join(TW_COLORS),
                                   "|".join(TW_STEPS)))

# Hex heuristic, documented because it is a heuristic: 6- and 8-digit forms are
# taken as colours; 3- and 4-digit forms only when they contain a hex letter, so
# an issue reference like #1234 is not reported as a colour.
RE_HEX = re.compile(r"#(?:[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?|[0-9a-fA-F]{3,4})\b")
RE_FUNC = re.compile(r"\b(?:rgba?|hsla?|oklch|oklab|lab|lch)\s*\(")
RE_TW_ARBITRARY = re.compile(r"-\[#(?:[0-9a-fA-F]{3,8})\]")
RE_DECL = re.compile(r"(--[a-zA-Z][a-zA-Z0-9-]*)\s*:")
# Name AND value, for the derived view. The audit itself never compares two
# values; rendering one so a human can look at it is a different act.
RE_DECL_VAL = re.compile(r"(--[a-zA-Z][a-zA-Z0-9-]*)\s*:\s*([^;}\n]+)")
RE_NODE = re.compile(r"^[0-9]+-[0-9]+$")
RE_FILEKEY = re.compile(r"^[A-Za-z0-9]{20,25}$")

SCAN_EXT = {".tsx", ".ts", ".jsx", ".js", ".mjs", ".cjs", ".css", ".scss",
            ".sass", ".less", ".html", ".vue", ".svelte", ".astro"}
SKIP_DIR = {".git", "node_modules", "dist", "build", "out", ".next", ".nuxt",
            ".output", "coverage", "vendor", "target", ".turbo", ".cache",
            "__pycache__", ".venv"}


def strip_comments(text, ext):
    """Kill commented-out colours before matching. Not a parser, and does not
    pretend to be — it removes the one class of false positive that actually
    shows up, which is a hex value someone commented out rather than deleted."""
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    if ext in (".html", ".vue", ".svelte", ".astro"):
        text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    # `//` only when not preceded by a colon or word char, so https:// survives.
    text = re.sub(r"(?<![:\w])//[^\n]*", "", text)
    return text


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def strip_trailing_comment(line):
    """Drop a trailing `# annotation` from a block line.

    This exists because the frozen contract in the template is ANNOTATED — every
    line carries `# required, unique` and the like — and the obvious way to author
    a row is to copy that block. Without this, doing the documented thing produced
    four malformed findings AND silently unparsed `roles:`, which turned the
    vocabulary rule off. That is the Product Spec scar again: the example the
    template gives must be the thing the validator accepts.

    A `#` is only a comment when whitespace follows it, so a hex value like #fff or
    an issue reference like #123 survives. A `#` inside a quoted value is left
    alone, because `hazard: "..."` is free text."""
    out, in_quote = [], None
    i = 0
    while i < len(line):
        ch = line[i]
        if in_quote:
            if ch == in_quote:
                in_quote = None
        elif ch in "\"'":
            in_quote = ch
        elif (ch == "#" and i > 0 and line[i - 1].isspace()
              and (i + 1 == len(line) or line[i + 1].isspace())):
            return "".join(out).rstrip()
        out.append(ch)
        i += 1
    return "".join(out)


def records(body):
    """Split a fenced block into `- key: value` records. Same shape the kit's
    other fenced blocks use: one record starts at a `- ` in column zero."""
    out, cur = [], None
    for raw in body.split("\n"):
        if raw.startswith("- "):
            if cur is not None:
                out.append(cur)
            cur = [raw[2:]]
        elif cur is not None and raw.strip():
            cur.append(raw.strip())
    if cur is not None:
        out.append(cur)
    parsed = []
    for rec in out:
        d = {}
        for line in rec:
            line = strip_trailing_comment(line)
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            d[k.strip()] = v.strip()
        parsed.append(d)
    return parsed


def listval(v):
    v = v.strip()
    if v.startswith("[") and v.endswith("]"):
        v = v[1:-1]
    return [x.strip() for x in v.split(",") if x.strip()]


def mapval(v):
    """Parse `{ file: abc, node: 1-2 }` — the same inline-mapping shape the kit
    already uses for `generated: { by:, at: }`."""
    v = v.strip().lstrip("{").rstrip("}")
    d = {}
    for part in v.split(","):
        if ":" in part:
            k, val = part.split(":", 1)
            d[k.strip()] = val.strip()
    return d


def utc_now():
    """Naive UTC. datetime.utcnow() is deprecated and warns on stderr from 3.12,
    and a tool that prints a warning on every run trains people to ignore its
    output. Naive rather than aware because it is compared against dates parsed
    from the canon with strptime, and mixing aware and naive raises."""
    return datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)


findings = []       # (severity, rule, location, detail)


def add(sev, rule, loc, detail):
    findings.append((sev, rule, loc, detail))


# ---------------------------------------------------------------------------
# 1. Read the contract out of the vault.
#    Globbed, not a fixed filename, so a block can move to a sibling note when
#    the index note outgrows its 200-line budget.
# ---------------------------------------------------------------------------
design_dir = os.path.join(vault, "Reference", "Design")
canon_files = []
for root, dirs, files in os.walk(design_dir):
    dirs[:] = sorted(d for d in dirs if d not in SKIP_DIR)
    for f in sorted(files):
        if f.endswith(".md"):
            canon_files.append(os.path.join(root, f))

KEYS_BY_FENCE = {"design-tokens": TOKEN_KEYS, "design-components": COMP_KEYS,
                 "design-tools": TOOL_KEYS}

vocabs, comps, tools = {}, [], {}
for path in canon_files:
    rel = os.path.relpath(path, vault)
    text = read_text(path)
    for kind, body in re.findall(
            r"```(design-tokens|design-components|design-tools)\n(.*?)```",
            text, flags=re.S):
        for rec in records(body):
            unknown = sorted(set(rec) - KEYS_BY_FENCE[kind])
            if unknown:
                add("VIOLATION", "DS-BLOCK-MALFORMED", rel,
                    "unknown key(s) in %s: %s" % (kind, ", ".join(unknown)))
            if kind == "design-tools":
                slug = rec.get("slug")
                if not slug or not rec.get("name"):
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "design-tools record missing slug or name")
                    continue
                if slug in tools:
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "duplicate tool slug: %s" % slug)
                k = rec.get("kind")
                if k and k not in KINDS:
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "unknown kind %r for %s" % (k, slug))
                roles = set(listval(rec.get("roles", "")))
                # Required, not optional. Rule 1 says omit a key you do not have,
                # which taught authors that leaving `roles` out was fine — and an
                # absent `roles` meant the vocabulary rule below could never fire.
                # A registry entry that cannot say what the tool DOES is not an
                # entry, and this rule must not be disableable by omission.
                if not roles:
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "%s: roles is required — without it nothing can check "
                        "whether the tool needs a vocabulary" % slug)
                for r in sorted(roles - ROLES):
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "unknown role %r for %s" % (r, slug))
                # Rule 9. A capability claim with no date is one somebody acts on
                # a year after it stopped being true.
                if not rec.get("checked"):
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "%s: checked is required — a tool claim needs the date "
                        "somebody last confirmed it" % slug)
                # Rule 10. Enforced here rather than left to review, because the
                # failure is silent: a fifth --primary, months later.
                if roles & WRITING_ROLES and not listval(rec.get("vocabulary", "")):
                    add("VIOLATION", "DS-TOOL-MALFORMED", rel,
                        "%s: roles %s write UI, so vocabulary is required"
                        % (slug, sorted(roles & WRITING_ROLES)))
                rec["_note"] = rel
                tools[slug] = rec
                continue
            if kind == "design-tokens":
                slug = rec.get("vocabulary")
                if not slug:
                    add("VIOLATION", "DS-BLOCK-MALFORMED", rel,
                        "design-tokens record with no vocabulary")
                    continue
                if slug in vocabs:
                    add("VIOLATION", "DS-BLOCK-MALFORMED", rel,
                        "duplicate vocabulary: %s" % slug)
                fmt = rec.get("format")
                if fmt and fmt not in FORMATS:
                    add("VIOLATION", "DS-BLOCK-MALFORMED", rel,
                        "unknown format %r for %s" % (fmt, slug))
                rec["_note"] = rel
                vocabs[slug] = rec
            else:
                if not rec.get("slug") or not rec.get("name"):
                    add("VIOLATION", "DS-BLOCK-MALFORMED", rel,
                        "design-components record missing slug or name")
                    continue
                rec["_note"] = rel
                comps.append(rec)

seen = set()
for c in comps:
    if c["slug"] in seen:
        add("VIOLATION", "DS-BLOCK-MALFORMED", c["_note"],
            "duplicate component slug: %s" % c["slug"])
    seen.add(c["slug"])

# Placeholder text defeats the whole design: absence is the signal, and coverage
# is derived from it, so a TODO reports as complete-but-broken.
PLACEHOLDER = {"todo", "tbd", "?", "n/a", "na", "-", "none", "xxx", "fixme"}
# Checked on pointer and enum keys only. `name` and `note` are free text, and a
# component legitimately called "Todo" or a note titled "None of the above" is not
# a placeholder — flagging it would be the tool's own first false positive.
PLACEHOLDER_KEYS = {"vocabulary", "source", "format", "scope", "catalog", "names",
                    "status", "of", "slug", "figma", "image", "impl", "tokens",
                    "kind", "roles", "ingest", "values-to", "checked"}
# `hazard` is deliberately absent from that set alongside `name` and `note`: it is
# free text, and a tool whose one trap really is "none" should be able to say so.
for rec in list(vocabs.values()) + comps + list(tools.values()):
    for k, v in sorted(rec.items()):
        if k.startswith("_") or k not in PLACEHOLDER_KEYS:
            continue
        if v.strip().lower() in PLACEHOLDER:
            add("VIOLATION", "DS-BLOCK-MALFORMED", rec["_note"],
                "%s: %r — omit the key instead; absence is the signal"
                % (k, v.strip()))

# Tool checks that need every vocabulary in hand, so they run after the walk.
# A tool pointed at a vocabulary that does not exist is worse than one pointed at
# nothing: it reads as governed.
for slug in sorted(tools):
    rec = tools[slug]
    for want in listval(rec.get("vocabulary", "")):
        if want not in vocabs:
            add("VIOLATION", "DS-TOOL-MALFORMED", rec["_note"],
                "%s: vocabulary %r is not declared in any design-tokens block"
                % (slug, want))
    # GAP, never a VIOLATION — a stale claim is an unchecked claim, not a defect,
    # and a rule that can fail --strict on the passage of time is a rule people
    # switch off. It decays into a visible absence instead of a silent lie.
    when_checked = rec.get("checked")
    if when_checked:
        try:
            seen_at = datetime.datetime.strptime(when_checked.strip(),
                                                 "%Y-%m-%d")
        except ValueError:
            add("VIOLATION", "DS-TOOL-MALFORMED", rec["_note"],
                "%s: checked %r is not a YYYY-MM-DD date"
                % (slug, when_checked.strip()))
        else:
            age = (utc_now() - seen_at).days
            if age > TOOL_STALE_DAYS:
                add("GAP", "DS-TOOL-STALE", rec["_note"],
                    "%s: checked %s, %d days ago — recheck what it can do"
                    % (slug, when_checked.strip(), age))

# ---------------------------------------------------------------------------
# 2. Resolve repo-prefixed pointers.
#    `dexhive-prod-frontend/src/x.css` resolves against a scanned repo whose
#    basename matches the first segment. If that repo was NOT scanned we report
#    nothing — an unscanned repo is unverifiable, not broken. Calling it dead
#    would be the tool's first false positive.
# ---------------------------------------------------------------------------
repo_by_name = {}
for p in repos:
    repo_by_name[os.path.basename(p.rstrip("/"))] = p

unverifiable = []


def resolve(pointer):
    p = pointer.split(":", 1)[0].strip()
    parts = p.split("/", 1)
    if len(parts) != 2:
        return None, False
    name, rest = parts
    root = repo_by_name.get(name)
    if root is None:
        return None, False        # repo not scanned → unverifiable
    return os.path.join(root, rest), True


declared_token_files = set()
for slug, rec in sorted(vocabs.items()):
    for key in ("source", "catalog"):
        ptr = rec.get(key)
        if not ptr:
            continue
        abspath, checkable = resolve(ptr)
        if not checkable:
            unverifiable.append("%s (%s of %s)" % (ptr, key, slug))
            continue
        declared_token_files.add(os.path.realpath(abspath))
        if not os.path.exists(abspath):
            add("VIOLATION", "DS-POINTER-DEAD", ptr,
                "%s of vocabulary %s does not exist" % (key, slug))

# `values-to` is repo-prefixed like impl/source (rule 4), so it gets the same
# treatment: a tool told to write values into a file that does not exist is a
# broken instruction, not a stylistic lapse.
for slug in sorted(tools):
    ptr = tools[slug].get("values-to")
    if not ptr:
        continue
    abspath, checkable = resolve(ptr)
    if not checkable:
        unverifiable.append("%s (values-to of %s)" % (ptr, slug))
    elif not os.path.exists(abspath):
        add("VIOLATION", "DS-POINTER-DEAD", ptr,
            "values-to of tool %s does not exist" % slug)

for c in comps:
    ptr = c.get("impl")
    if ptr:
        abspath, checkable = resolve(ptr)
        if not checkable:
            unverifiable.append("%s (impl of %s)" % (ptr, c["slug"]))
        elif not os.path.exists(abspath):
            add("VIOLATION", "DS-POINTER-DEAD", ptr,
                "impl of component %s does not exist" % c["slug"])
    img = c.get("image")
    if img and not os.path.exists(os.path.join(vault, img)):
        add("VIOLATION", "DS-ASSET-MISSING", img,
            "image for %s is not in the vault" % c["slug"])
    fig = c.get("figma")
    if fig:
        m = mapval(fig)
        raw = fig.lower()
        if "figma.com" in raw or "t=" in raw:
            add("VIOLATION", "DS-FIGMA-MALFORMED", c["_note"],
                "%s: store file + node, not a URL — URLs carry a rename-fragile "
                "slug and often a t= session parameter" % c["slug"])
        else:
            if not RE_FILEKEY.match(m.get("file", "")):
                add("VIOLATION", "DS-FIGMA-MALFORMED", c["_note"],
                    "%s: file %r is not a Figma file key" % (c["slug"], m.get("file", "")))
            if not RE_NODE.match(m.get("node", "")):
                add("VIOLATION", "DS-FIGMA-MALFORMED", c["_note"],
                    "%s: node %r is not dash form (e.g. 2566-21359)"
                    % (c["slug"], m.get("node", "")))
    voc = c.get("vocabulary")
    if voc and voc not in vocabs:
        add("GAP", "DS-TOKEN-UNDECLARED", c["_note"],
            "%s references unknown vocabulary %s" % (c["slug"], voc))

# ---------------------------------------------------------------------------
# 3. Name-set comparison. Names and format labels only — never values.
# ---------------------------------------------------------------------------
for slug, rec in sorted(vocabs.items()):
    declared = set(listval(rec.get("names", "")))
    src = rec.get("source")
    if not (src and declared):
        continue
    abspath, checkable = resolve(src)
    if not (checkable and os.path.exists(abspath)):
        continue
    actual = set(RE_DECL.findall(read_text(abspath)))
    for n in sorted(actual - declared):
        add("GAP", "DS-TOKEN-UNDECLARED", src,
            "%s declares %s, the canon does not list it" % (slug, n))
    for n in sorted(declared - actual):
        add("GAP", "DS-TOKEN-MISSING", src,
            "the canon lists %s for %s, the file does not declare it" % (n, slug))

by_name = {}
for slug, rec in sorted(vocabs.items()):
    for n in listval(rec.get("names", "")):
        by_name.setdefault(n, []).append((slug, rec.get("format", "?")))
for n, owners in sorted(by_name.items()):
    fmts = sorted({f for _, f in owners})
    if len(owners) > 1 and len(fmts) > 1:
        add("GAP", "DS-FORMAT-SPLIT", n,
            "declared in %s across formats %s — same name, different colour space"
            % (", ".join(s for s, _ in owners), ", ".join(fmts)))

# ---------------------------------------------------------------------------
# 3b. The resolved canon, as one model.
#     Built once and rendered two ways: markdown for people, JSON for agents.
#     It exists because both audiences were otherwise re-deriving it — a human by
#     opening five notes and a CSS file, an agent by reimplementing the subtree
#     glob and the three fence regexes. Neither should have to.
#
#     Values ARE resolved here, read from the repo at call time. That does not
#     contradict names-in-the-vault: nothing is stored. This is a dated, derived
#     artifact, exactly like the audit report, and it is regenerated or it is wrong.
# ---------------------------------------------------------------------------
def read_values(rec):
    """Current values for one vocabulary, read from its source file.

    Returns (values, status). status is 'read', 'unverifiable' when the naming
    repo was not scanned, or 'missing' when it was and the file is not there —
    the same three-way distinction the pointer checks make, for the same reason:
    an unscanned repo is unknown, not empty."""
    src = rec.get("source")
    if not src:
        return {}, "no-source"
    abspath, checkable = resolve(src)
    if not checkable:
        return {}, "unverifiable"
    if not os.path.exists(abspath):
        return {}, "missing"
    found = {}
    for name, raw in RE_DECL_VAL.findall(read_text(abspath)):
        val = raw.strip().rstrip(";").strip()
        # First declaration wins. A file with :root and a .dark block declares the
        # same name twice, and picking the later one would silently show dark mode.
        if name not in found and val:
            found[name] = val
    return found, "read"


def unquote(v):
    """Strip the surrounding quotes a block value may carry. `hazard: "..."` is
    quoted in the contract so a colon inside it cannot split the record, but the
    quotes are syntax, not content, and rendering them looks like a typo."""
    if not v:
        return v
    v = v.strip()
    if len(v) > 1 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


def css_value(fmt, raw):
    """A browser-resolvable colour for a declared value, or None.

    The canon's rule is that value equivalence is the browser's problem, not a
    regex's. This is that rule applied: wrap the bare value in whatever function
    its declared format implies and let the renderer do the colour science."""
    v = raw.strip()
    if not v or "var(" in v:
        return None
    if fmt == "hsl-triplet":
        return "hsl(%s)" % v
    if fmt == "rgb-triplet":
        return "rgb(%s)" % v
    if fmt in ("hex", "named", "oklch"):
        return v
    return None


resolved = {"vocabularies": [], "components": [], "tools": [], "collisions": []}

for slug, rec in sorted(vocabs.items()):
    vals, status = read_values(rec)
    declared = listval(rec.get("names", ""))
    resolved["vocabularies"].append({
        "vocabulary": slug,
        "format": rec.get("format"),
        "status": rec.get("status"),
        "of": rec.get("of"),
        "source": rec.get("source"),
        "scope": rec.get("scope"),
        "values_status": status,
        "tokens": [{"name": n, "value": vals.get(n)} for n in declared] or
                  [{"name": n, "value": v} for n, v in sorted(vals.items())],
        "note": rec.get("_note"),
    })

for c in comps:
    resolved["components"].append({
        "slug": c.get("slug"), "name": c.get("name"),
        "vocabulary": c.get("vocabulary"), "status": c.get("status"),
        "resolves": {
            "image": c.get("image"), "figma": c.get("figma"), "impl": c.get("impl"),
        },
        "tokens": listval(c.get("tokens", "")),
        "note": c.get("_note"),
    })

for slug in sorted(tools):
    t = tools[slug]
    resolved["tools"].append({
        "slug": slug, "name": t.get("name"), "kind": t.get("kind"),
        "roles": listval(t.get("roles", "")),
        "emits": listval(t.get("emits", "")),
        "vocabulary": listval(t.get("vocabulary", "")),
        "values_to": t.get("values-to"), "ingest": t.get("ingest"),
        "version": unquote(t.get("version")), "checked": t.get("checked"),
        "hazard": unquote(t.get("hazard")), "note": t.get("_note"),
    })

# The collision table is the one thing no existing artifact showed a human: the
# same name owned by several vocabularies. Reported whenever it is shared, not
# only when formats differ — a shared name is worth seeing even inside one format,
# because that is where "I assumed they matched" starts.
for n, owners in sorted(by_name.items()):
    if len(owners) > 1:
        resolved["collisions"].append({
            "token": n,
            "vocabularies": [s for s, _ in owners],
            "formats": sorted({f for _, f in owners}),
            "split": len({f for _, f in owners}) > 1,
        })


# ---------------------------------------------------------------------------
# 4. Scan the repos. Read-only, always.
# ---------------------------------------------------------------------------
def tracked_files(repo):
    """Prefer git's index over a filesystem walk.

    Build output is the biggest false-positive source there is: a Qwik or Next
    build emits bundled CSS-in-JS full of palette utilities, and counting it says
    nothing about what anyone wrote. Those directories are gitignored by every
    project that has them, and no hardcoded skip-list keeps up with framework
    conventions — `server/`, `.output/`, `.svelte-kit/`, `storybook-static/` — while
    also being a legitimate source directory name somewhere else.

    So: if it is a git repo, scan what git tracks. Otherwise fall back to a walk.
    Returns None when git is unavailable so the caller can walk instead.
    """
    if not os.path.isdir(os.path.join(repo, ".git")):
        return None
    try:
        import subprocess
        out = subprocess.run(["git", "-C", repo, "ls-files", "-z"],
                             capture_output=True, check=False)
        if out.returncode != 0:
            return None
        names = [n for n in out.stdout.decode("utf-8", "replace").split("\0") if n]
        return names or None
    except Exception:
        return None


def excludes_for(repo):
    pats = []
    f = os.path.join(repo, ".canon-design-exclude")
    for line in read_text(f).split("\n"):
        line = line.split("#", 1)[0].strip()
        if line:
            try:
                pats.append(re.compile(line))
            except re.error:
                pass
    return pats


files_with_findings = set()
scanned_files = 0

for repo in repos:
    if not os.path.isdir(repo):
        add("VIOLATION", "DS-POINTER-DEAD", repo, "not a directory")
        continue
    name = os.path.basename(repo.rstrip("/"))
    pats = excludes_for(repo)

    rels = tracked_files(repo)
    if rels is None:
        rels = []
        for root, dirs, files in os.walk(repo):
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIR)
            for fn in sorted(files):
                rels.append(os.path.relpath(os.path.join(root, fn), repo))
    else:
        rels = [r for r in rels
                if not any(part in SKIP_DIR for part in r.split("/"))]

    for rel in sorted(rels):
            fn = os.path.basename(rel)
            ext = os.path.splitext(fn)[1]
            if ext not in SCAN_EXT:
                continue
            if fn.endswith((".min.js", ".min.css", ".map")):
                continue
            full = os.path.join(repo, rel)
            if not os.path.isfile(full):
                continue
            # The skip-list is LEARNED FROM THE CANON: a file the canon names as
            # a token source is supposed to contain literals. Declaring a new
            # vocabulary therefore silences its own false positives.
            if os.path.realpath(full) in declared_token_files:
                continue
            if any(p.search(rel) for p in pats):
                continue
            scanned_files += 1
            text = strip_comments(read_text(full), ext)
            for i, line in enumerate(text.split("\n"), 1):
                loc = "%s/%s:%d" % (name, rel, i)
                for m in RE_PALETTE.finditer(line):
                    add("VIOLATION", "DS-PALETTE-UTILITY", loc, m.group(0))
                    files_with_findings.add(loc.rsplit(":", 1)[0])
                for m in RE_TW_ARBITRARY.finditer(line):
                    add("VIOLATION", "DS-COLOR-LITERAL", loc, m.group(0))
                    files_with_findings.add(loc.rsplit(":", 1)[0])
                for m in RE_HEX.finditer(line):
                    add("VIOLATION", "DS-COLOR-LITERAL", loc, m.group(0))
                    files_with_findings.add(loc.rsplit(":", 1)[0])
                for m in RE_FUNC.finditer(line):
                    add("VIOLATION", "DS-COLOR-LITERAL", loc, m.group(0).strip())
                    files_with_findings.add(loc.rsplit(":", 1)[0])

# ---------------------------------------------------------------------------
# 5. Counts, coverage, baseline.
# ---------------------------------------------------------------------------
counts = {}
for sev, rule, _, _ in findings:
    counts[rule] = counts.get(rule, 0) + 1
severity = {}
for sev, rule, _, _ in findings:
    severity[rule] = sev

total = len(comps)
cov = {
    "image": sum(1 for c in comps if c.get("image")),
    "figma": sum(1 for c in comps if c.get("figma")),
    "impl": sum(1 for c in comps if c.get("impl")),
    "absent": sum(1 for c in comps if c.get("status") == "absent"),
}
# Reported as a count of what is declared, never as a score. Zero registered tools
# is a legitimate state and reads as one.
tool_summary = {
    "registered": len(tools),
    "writing": sum(1 for t in tools.values()
                   if set(listval(t.get("roles", ""))) & WRITING_ROLES),
}

baseline = {}
for repo in repos:
    for line in read_text(os.path.join(repo, ".canon-design-baseline")).split("\n"):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit():
            baseline[parts[0]] = baseline.get(parts[0], 0) + int(parts[1])

if baseline_write:
    print("# canon-design-audit baseline. --strict fails only when a count EXCEEDS")
    print("# these. Lower them as you clean up; that is the whole point.")
    for rule in sorted(counts):
        if severity.get(rule) == "VIOLATION":
            print("%s %d" % (rule, counts[rule]))
    sys.exit(0)

regressions = []
for rule in sorted(counts):
    if severity.get(rule) != "VIOLATION":
        continue
    allowed = baseline.get(rule, 0)
    if counts[rule] > allowed:
        regressions.append((rule, counts[rule], allowed))

CAP = 20
findings.sort(key=lambda f: (f[0] != "VIOLATION", f[1], f[2]))


def render_view(when):
    """The design system as one document, for people and agents both.

    Plain markdown on purpose: a human reads it in Obsidian, an agent greps it.
    The kit's own rule is Bases for human dashboards and plain text for anything an
    agent must read — and a Base cannot see inside a fenced block, so the only
    surface that serves both is a derived one."""
    out = []
    out.append("---")
    out.append("type: output")
    out.append("status: stable")
    out.append("date: %s" % when.date().isoformat())
    out.append("generated:")
    out.append("  by: process:canon-design-audit")
    out.append("  at: %sZ" % when.replace(microsecond=0).isoformat())
    out.append("stale_after: %s"
               % (when + datetime.timedelta(days=30)).date().isoformat())
    out.append("tool_version: %s" % version)
    out.append("repos_scanned: [%s]"
               % ", ".join(os.path.basename(r.rstrip("/")) for r in repos))
    out.append("---")
    out.append("")
    out.append("# Design System View — %s" % when.date().isoformat())
    out.append("")
    out.append("Every token name, component and approved tool in the canon, with the "
               "values read out of the code on this run. **Do not hand-edit** — change "
               "the canon or change the code and re-run. Values are shown here because "
               "this file is derived and dated; they are still not stored in the vault.")
    out.append("")

    if resolved["tools"]:
        out.append("## What to build UI with")
        out.append("")
        out.append("| Tool | Kind | Roles | Targets | Checked | Watch out for |")
        out.append("|---|---|---|---|---|---|")
        for t in resolved["tools"]:
            out.append("| %s | %s | %s | %s | %s | %s |" % (
                t["name"] or t["slug"], t["kind"] or "—",
                ", ".join(t["roles"]) or "—",
                ", ".join("`%s`" % v for v in t["vocabulary"]) or "—",
                t["checked"] or "—", t["hazard"] or ""))
        out.append("")

    out.append("## Token vocabularies")
    out.append("")
    if not resolved["vocabularies"]:
        out.append("None declared.")
        out.append("")
    for v in resolved["vocabularies"]:
        head = "### `%s` — %s" % (v["vocabulary"], v["format"] or "format unstated")
        if v["status"]:
            head += " · %s" % v["status"]
        if v["of"]:
            head += " of `%s`" % v["of"]
        out.append(head)
        out.append("")
        if v["source"]:
            out.append("Values in `%s`." % v["source"])
        note = {
            "unverifiable": "**Values not shown** — the naming repo was not scanned "
                            "on this run. Unknown, not empty.",
            "missing": "**Values not shown** — the source file does not exist. "
                       "That is also reported as `DS-POINTER-DEAD`.",
            "no-source": "**No source declared**, so there is nothing to read.",
        }.get(v["values_status"])
        if note:
            out.append("")
            out.append(note)
        out.append("")
        if v["values_status"] == "read":
            out.append("| Token | Value | |")
            out.append("|---|---|---|")
            for t in v["tokens"]:
                val, sw = t["value"], ""
                if val:
                    css = css_value(v["format"], val)
                    if css:
                        # Renders as a colour chip in Obsidian and on GitHub-style
                        # viewers; degrades to nothing in a plain text reader, which
                        # is why the value itself is its own column.
                        sw = ('<span style="display:inline-block;width:2.5rem;'
                              'height:1rem;background:%s;border:1px solid #767676;'
                              'vertical-align:middle"></span>' % css)
                out.append("| `%s` | %s | %s |"
                           % (t["name"], "`%s`" % val if val else "*not declared*", sw))
            out.append("")

    if resolved["collisions"]:
        out.append("## Names owned by more than one vocabulary")
        out.append("")
        out.append("The place drift starts. A shared name does **not** mean a shared "
                   "value, and nothing in the code will tell you when it stops "
                   "matching. Rows marked ⚠ also differ in colour space, which is "
                   "reported as `DS-FORMAT-SPLIT`.")
        out.append("")
        out.append("| Token | Declared in | Formats | |")
        out.append("|---|---|---|---|")
        for c in resolved["collisions"]:
            out.append("| `%s` | %s | %s | %s |" % (
                c["token"], ", ".join("`%s`" % v for v in c["vocabularies"]),
                ", ".join(c["formats"]), "⚠" if c["split"] else ""))
        out.append("")

    out.append("## Components")
    out.append("")
    if not resolved["components"]:
        out.append("None declared.")
    else:
        out.append("A blank cell means that rung does not resolve, and that is a "
                   "fact rather than an oversight — an omitted key is how this canon "
                   "records an absence.")
        out.append("")
        out.append("| Component | Vocabulary | Image | Figma | Code | Status |")
        out.append("|---|---|---|---|---|---|")
        for c in resolved["components"]:
            r = c["resolves"]
            out.append("| %s | %s | %s | %s | %s | %s |" % (
                c["name"] or c["slug"],
                "`%s`" % c["vocabulary"] if c["vocabulary"] else "—",
                "✓" if r["image"] else "", "✓" if r["figma"] else "",
                "`%s`" % r["impl"] if r["impl"] else "",
                c["status"] or "—"))
    out.append("")
    out.append("---")
    out.append("")
    out.append("No score is recorded, here or anywhere. For what has drifted, read "
               "the newest `Design System Audit` beside this file.")
    return "\n".join(out) + "\n"


def render_report(when):
    stale = (when + datetime.timedelta(days=30)).date().isoformat()
    out = []
    out.append("---")
    out.append("type: output")
    out.append("status: stable")
    out.append("date: %s" % when.date().isoformat())
    out.append("generated:")
    out.append("  by: process:canon-design-audit")
    out.append("  at: %sZ" % when.replace(microsecond=0).isoformat())
    out.append("stale_after: %s" % stale)
    out.append("tool_version: %s" % version)
    out.append("repos_scanned: [%s]"
               % ", ".join(os.path.basename(r.rstrip("/")) for r in repos))
    out.append("---")
    out.append("")
    out.append("# Design System Audit — %s" % when.date().isoformat())
    out.append("")
    out.append("Derived from the design canon in `Reference/Design/` plus the code, "
               "recomputed on this run. **Nothing here is stored anywhere else.** "
               "Do not hand-edit — change the canon or change the code, and re-run.")
    out.append("")
    out.append("Scanned %d file(s) across %d repo(s)."
               % (scanned_files, len(repos)))
    out.append("")
    out.append("| Rule | Severity | Count | Baseline |")
    out.append("|---|---|---|---|")
    for rule in sorted(counts):
        out.append("| `%s` | %s | %d | %s |"
                   % (rule, severity.get(rule, "?"), counts[rule],
                      baseline.get(rule, "—") if severity.get(rule) == "VIOLATION" else "n/a"))
    if not counts:
        out.append("| — | — | 0 | — |")
    out.append("")
    out.append("## Coverage")
    out.append("")
    out.append("Derived from which keys are present, so an omitted key reads as a "
               "gap rather than as done:")
    out.append("")
    out.append("- **%d of %d** components resolve to an exported image" % (cov["image"], total))
    out.append("- **%d of %d** resolve to a Figma node" % (cov["figma"], total))
    out.append("- **%d of %d** resolve to an implementation" % (cov["impl"], total))
    out.append("- **%d** are recorded as deliberately absent" % cov["absent"])
    if tools:
        out.append("- **%d** design tool(s) registered, **%d** of which write UI"
                   % (tool_summary["registered"], tool_summary["writing"]))
    out.append("")
    for rule in sorted(counts):
        rows = [f for f in findings if f[1] == rule]
        out.append("## %s — %s (%d)" % (rule, severity.get(rule, "?"), len(rows)))
        out.append("")
        for _, _, loc, detail in rows[:CAP]:
            out.append("- `%s` — %s" % (loc, detail))
        if len(rows) > CAP:
            out.append("- … and %d more" % (len(rows) - CAP))
        out.append("")
    if unverifiable:
        out.append("## Unverifiable pointers")
        out.append("")
        out.append("Named repos that were not scanned. Not reported as dead — an "
                   "unscanned repo is unknown, not broken.")
        out.append("")
        for u in sorted(set(unverifiable))[:CAP]:
            out.append("- `%s`" % u)
        out.append("")
    out.append("---")
    out.append("")
    out.append("No score is recorded, here or anywhere. Counts are facts with "
               "locations; a grade would be a stored judgement that is wrong the "
               "next day. Re-run to refresh.")
    return "\n".join(out) + "\n"


if mode == "export":
    # The canon itself, not an opinion about it. Agents were otherwise each
    # reimplementing the Reference/Design/ glob and the three fence regexes; this is
    # that work done once, in the place the contract is already frozen.
    print(json.dumps({
        "tool_version": version,
        "vault": vault,
        "repos": repos,
        "canon": resolved,
    }, indent=2, sort_keys=True))
    sys.exit(0)

if mode == "json":
    payload = {
        "tool_version": version,
        "vault": vault,
        "repos": repos,
        "scanned_files": scanned_files,
        "counts": counts,
        "severity": severity,
        "coverage": dict(cov, total=total),
        "baseline": baseline,
        "regressions": [{"rule": r, "count": c, "baseline": b} for r, c, b in regressions],
        "unverifiable": sorted(set(unverifiable)),
        "findings": [{"severity": s, "rule": r, "location": l, "detail": d}
                     for s, r, l, d in findings],
    }
    # Emitted only when the block is used, so a vault that registers no tools gets
    # byte-identical output to a build without this feature. A registry nobody has
    # filled in should be invisible, not a row of zeroes.
    if tools:
        payload["tools"] = tool_summary
    print(json.dumps(payload, indent=2, sort_keys=True))
elif not quiet:
    print("canon-design-audit %s" % version)
    print("  vault: %s" % vault)
    print("  scanned %d file(s) in %d repo(s)" % (scanned_files, len(repos)))
    print("  canon: %d vocabular(ies), %d component(s)" % (len(vocabs), total))
    if tools:
        print("  tools: %d registered, %d that write UI"
              % (tool_summary["registered"], tool_summary["writing"]))
    print("")
    if not counts:
        print("  no findings")
    for rule in sorted(counts):
        print("  %-9s %-22s %d" % (severity.get(rule, "?"), rule, counts[rule]))
        for _, _, loc, detail in [f for f in findings if f[1] == rule][:5]:
            print("              %s  %s" % (loc, detail))
        if counts[rule] > 5:
            print("              … and %d more" % (counts[rule] - 5))
    print("")
    print("  coverage: image %d/%d · figma %d/%d · impl %d/%d · absent %d"
          % (cov["image"], total, cov["figma"], total, cov["impl"], total, cov["absent"]))
    if unverifiable:
        print("  %d pointer(s) unverifiable (repo not scanned)" % len(set(unverifiable)))
else:
    for rule in sorted(counts):
        print("%s %d" % (rule, counts[rule]))

if do_report:
    when = utc_now()
    outdir = os.path.join(vault, "Outputs")
    os.makedirs(outdir, exist_ok=True)
    dest = os.path.join(outdir, "%s — Design System Audit.md" % when.date().isoformat())
    with open(dest, "w", encoding="utf-8") as fh:
        fh.write(render_report(when))
    if not quiet and mode != "json":
        print("  report: %s" % os.path.relpath(dest, vault))

if do_view:
    when = utc_now()
    outdir = os.path.join(vault, "Outputs")
    os.makedirs(outdir, exist_ok=True)
    dest = os.path.join(outdir, "%s — Design System View.md" % when.date().isoformat())
    with open(dest, "w", encoding="utf-8") as fh:
        fh.write(render_view(when))
    if not quiet and mode != "json":
        print("  view: %s" % os.path.relpath(dest, vault))

if strict and regressions:
    sys.stderr.write("\ncanon-design-audit: VIOLATION counts above baseline\n")
    for rule, c, b in regressions:
        sys.stderr.write("  %s: %d (baseline %d)\n" % (rule, c, b))
    sys.stderr.write("Write a baseline with --baseline-write if this is the "
                     "starting point rather than a regression.\n")
    sys.exit(1)
sys.exit(0)
