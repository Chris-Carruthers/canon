#!/usr/bin/env bash
# canon-status — is the vault in step with the team? One line, or silence.
#
#   canon-status [/path/to/vault] [--quiet]
#
# Prints nothing and exits 0 when everything is in step, so it is safe to call from
# a hook or a shell prompt without adding noise. Exits 1 when something wants doing.
#
# DELIBERATELY NO NETWORK CALL. Two of the three signals are purely local:
#
#   uncommitted files   git status         instant
#   unpushed commits    origin/main..HEAD  instant, uses the local ref
#   staleness           mtime of .git/FETCH_HEAD — how long since anyone checked
#                       for updates. A real "behind origin" count needs git fetch,
#                       which in a session-start hook means a network round trip that
#                       is slow on a bad connection and hangs offline. The proxy is
#                       honest about what it is and costs nothing.
#
# Why this is on by default when auto-pull and auto-commit are not: those MUTATE a
# repository the user did not ask you to touch. This only tells them something true.

set -uo pipefail

CANON_VERSION="0.3.0"
case "${1:-}" in
  --version|-V) printf 'canon %s\n' "$CANON_VERSION"; exit 0 ;;
  -h|--help)    sed -n '2,/^[^#]/p' "$0" | sed '$d;s/^#[[:space:]]\{0,1\}//'; exit 0 ;;
esac

VAULT=""; QUIET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1; shift ;;
    -h|--help) sed -n '2,/^[^#]/p' "$0" | sed '$d;s/^#[[:space:]]\{0,1\}//'; exit 0 ;;
    *) VAULT="$1"; shift ;;
  esac
done

if [ -z "$VAULT" ]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  R="$HERE/canon-path"; [ -x "$R" ] || R="$(command -v canon-path 2>/dev/null || true)"
  [ -n "$R" ] && [ -x "$R" ] && VAULT="$("$R" 2>/dev/null || true)"
fi
[ -n "$VAULT" ] && [ -d "$VAULT/.git" ] || exit 0    # no vault, nothing to say

STALE_DAYS="${CANON_STALE_DAYS:-2}"

DIRTY="$(git -C "$VAULT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
BRANCH="$(git -C "$VAULT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
AHEAD=0
git -C "$VAULT" rev-parse --verify --quiet "origin/$BRANCH" >/dev/null 2>&1 \
  && AHEAD="$(git -C "$VAULT" rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null || echo 0)"

# Is there a team to be out of step WITH? A vault with no remote is not behind,
# it is solo — and "never pulled from the team" is then both false and, worse,
# unfixable: canon-sync has nothing to pull from. canon-init-vault creates a repo
# with no remote, so that is the state of EVERY vault on its first run, and
# permanently for anyone working alone. The hook that prints this tells the agent
# to raise it every session, so the first experience of canon was a standing
# complaint about a team that does not exist yet.
HAS_REMOTE=0
[ -n "$(git -C "$VAULT" remote 2>/dev/null)" ] && HAS_REMOTE=1

DAYS=""
FH="$VAULT/.git/FETCH_HEAD"
if [ -f "$FH" ]; then
  # python3 rather than stat. `stat -f %m` is BSD and `stat -c %Y` is GNU, and the
  # obvious fallback chain is WRONG: on GNU, -f means --file-system, so it succeeds
  # with filesystem info instead of failing, and the || never fires. That passed on
  # macOS and broke on Linux. python3 is already a hard dependency and behaves the
  # same everywhere, so use it and stop guessing at coreutils dialects.
  DAYS="$(python3 -c '
import os, sys, time
try: print(int((time.time() - os.path.getmtime(sys.argv[1])) // 86400))
except Exception: print("")' "$FH" 2>/dev/null || echo "")"
fi

REASONS=""
add() { REASONS="${REASONS}${REASONS:+ · }$1"; }

# ── is the INSTALL stale? ────────────────────────────────────────────────────
# Separate question from "is the vault in step with the team", and invisible
# without asking. Hooks and .canon/ tools are COPIES: upgrading the kit does
# nothing to a repo wired weeks ago or a vault scaffolded last month, and nothing
# about the files says how old they are. Two checks, both cheap:
#
#   drift    what wrote the vault / this repo, versus what is running now. Pure
#            local file reads, no network.
#   release  whether a newer version was published. That needs the network, which
#            this command promises never to touch — so it does NOT look. canon-sync
#            already makes a network call and writes the answer to a cache file;
#            this only reads it. Offline stays offline.
STALE=""
stale() { STALE="${STALE}${STALE:+ · }$1"; }

vfile() { [ -f "$1" ] && tr -d ' \t\r\n' < "$1" || true; }
VAULT_V="$(vfile "$VAULT/.canon/.canon-version")"
REPO_V=""
[ -n "${CANON_REPO:-}" ] && REPO_V="$(vfile "$CANON_REPO/.claude/hooks/.canon-version")"

[ -n "$VAULT_V" ] && [ "$VAULT_V" != "$CANON_VERSION" ] \
  && stale "vault tools are $VAULT_V, this is $CANON_VERSION — re-run canon-init-vault"
[ -n "$REPO_V" ] && [ "$REPO_V" != "$CANON_VERSION" ] \
  && stale "this repo's hooks are $REPO_V, this is $CANON_VERSION — re-run install.sh"

# Written by canon-sync, which is the one command already making a network call.
LATEST="$(vfile "${XDG_CACHE_HOME:-$HOME/.cache}/canon/latest-release")"
[ -n "$LATEST" ] && [ "$LATEST" != "$CANON_VERSION" ] \
  && stale "canon $LATEST has been released, you are on $CANON_VERSION"

ONBRANCH=0
case "$BRANCH" in canon/*) ONBRANCH=1 ;; esac

[ "$DIRTY" -gt 0 ] && add "$DIRTY uncommitted file(s)"
[ "$AHEAD" -gt 0 ] && add "$AHEAD commit(s) not shared with the team"
# A pushed review branch is AHEAD=0 and DIRTY=0, so every other signal here says
# "in step" — while the notes are sitting in an unmerged pull request that nobody
# else's vault contains. Same failure as an unpushed commit, one step further out.
[ "$ONBRANCH" = "1" ] && add "on review branch $BRANCH, not merged into the shared vault"
if [ "$HAS_REMOTE" = "1" ]; then
  [ -n "$DAYS" ] && [ "$DAYS" -ge "$STALE_DAYS" ] && add "last checked for teammates' updates ${DAYS}d ago"
  [ -z "$DAYS" ] && add "never pulled from the team"
fi

[ -z "$REASONS" ] && [ -z "$STALE" ] && exit 0
[ "$QUIET" = "1" ] && exit 1

# The install line goes FIRST when the vault itself is in step: an out-of-date
# install is the more surprising fact, and burying it under sync advice is how it
# stays unnoticed for months.
[ -n "$STALE" ] && printf 'canon install: %s\n' "$STALE"
[ -z "$REASONS" ] && exit 1

printf 'Knowledge vault: %s\n' "$REASONS"
if [ "$ONBRANCH" = "1" ]; then
  printf '  Get it reviewed:  open the pull request for %s\n' "$BRANCH"
elif [ "$HAS_REMOTE" = "0" ]; then
  # Local-only: committing is the whole of "safe" here. Do not advertise --push;
  # there is nowhere to push, and naming a command that cannot work reads as a
  # broken tool rather than as a vault that simply has no remote yet.
  printf '  Save it locally:  canon-sync   (no remote yet — add one to share with a team)\n'
elif [ "$DIRTY" -gt 0 ] || [ "$AHEAD" -gt 0 ]; then
  printf '  Share your work:  canon-sync --push\n'
else
  printf '  Get up to date:   canon-sync\n'
fi
exit 1
