#!/usr/bin/env bash
# canon-init-vault — scaffold a new knowledge vault, or top up an existing one.
#
#   canon-init-vault [--pack <name>]... /path/to/vault
#
# Optional template packs are NOT installed by default. The core set is small on
# purpose; see canon-pack for what is available and why.
#
# Non-destructive: never overwrites an existing file. Safe to re-run to pick up
# new templates after upgrading the kit.

set -euo pipefail

CANON_VERSION="0.2.0"
case "${1:-}" in --version|-V) printf 'canon %s\n' "$CANON_VERSION"; exit 0 ;; esac


KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TPL="$KIT_DIR/templates/vault"

VAULT=""; WANT_PACKS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pack) shift; [ -n "${1:-}" ] || { echo "canon-init-vault: --pack needs a name" >&2; exit 2; }
            WANT_PACKS="$WANT_PACKS $1"; shift ;;
    --pack=*) WANT_PACKS="$WANT_PACKS ${1#--pack=}"; shift ;;
    *) VAULT="$1"; shift ;;
  esac
done
[ -n "$VAULT" ] || { echo "usage: canon-init-vault [--pack <name>]... /path/to/vault" >&2; exit 2; }
mkdir -p "$VAULT"
VAULT="$(cd "$VAULT" && pwd)"

echo "Scaffolding vault at $VAULT"

for d in Vision Projects Clients Decisions Reference Sessions Specs Handoffs Outputs Sources Templates Attachments _Inbox; do
  mkdir -p "$VAULT/$d"
done

copied=0; skipped=0
while IFS= read -r rel; do
  src="$TPL/$rel"; dst="$VAULT/$rel"
  mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ]; then
    skipped=$((skipped+1))
  else
    cp "$src" "$dst"; copied=$((copied+1)); printf '  + %s\n' "$rel"
  fi
  # Copy EVERY template file, not a name-filtered subset. The filtered version
  # silently skipped .canon-owners and .github/CODEOWNERS — governance config
  # that never arrived, which is the worst kind of missing file.
done < <(cd "$TPL" && find . -type f ! -name '.DS_Store' | sed 's|^\./||')

printf '  %d file(s) added, %d left alone\n' "$copied" "$skipped"

# EVERY folder needs a .gitkeep. Git does not track empty directories, so
# without these a teammate's fresh clone is missing Sessions/, Decisions/ and
# the rest — and tooling that checks "does this folder exist" then silently does
# nothing, which is the worst possible failure mode.
for d in Vision Projects Clients Decisions Reference Sessions Specs Handoffs Outputs Sources Templates Attachments _Inbox; do
  [ -e "$VAULT/$d/.gitkeep" ] || : > "$VAULT/$d/.gitkeep"
done

# Vendor the tools INTO the vault so a fresh clone can bootstrap itself with no
# other checkout present. This is what makes onboarding a single command.
# canon-pack is deliberately NOT in this list: unlike the others it is not
# self-contained — it copies files out of the kit's templates/packs/, which is not
# in the vault. A vendored copy would resolve an empty pack directory and report
# "no packs available", which reads as a fact rather than a broken install.
mkdir -p "$VAULT/.canon"
# This list is hand-maintained, which means a new tool is one forgotten edit
# away from never reaching a vault. test/run.sh asserts every canon-*-audit in
# bin/ appears here, so the omission fails a build instead of going unnoticed.
for tool in canon-scan canon-guard canon-path canon-install-vault-hooks canon-trust canon-verify canon-status canon-design-audit canon-test-audit; do
  [ -f "$KIT_DIR/bin/$tool" ] && cp "$KIT_DIR/bin/$tool" "$VAULT/.canon/$tool"
  [ -f "$VAULT/.canon/$tool" ] && chmod +x "$VAULT/.canon/$tool"
done
echo "  vendored .canon/{canon-scan,canon-guard,canon-path,canon-install-vault-hooks,canon-trust,canon-verify,canon-status,canon-design-audit,canon-test-audit}"

# Optional packs, through canon-pack so there is exactly one copy path and one set
# of semantics. Same non-destructive contract as everything above.
for pk in $WANT_PACKS; do
  echo "  pack: $pk"
  "$KIT_DIR/bin/canon-pack" add "$pk" "$VAULT" | sed 's/^/  /'
done

if [ ! -d "$VAULT/.git" ]; then
  git -C "$VAULT" init --quiet 2>/dev/null && echo "  initialised git repo"
fi

cat <<EOF

Done. Next:
  1. Fill in Vision/Agent Router.md — delete folders you do not use.
     Keep it under 150 lines; it is the only file agents load every session.
  2. Set the path once per machine — or just run the bootstrap, which does it:
       ./.canon/bootstrap.sh
     (or export CANON_HOME, or add a .canon file per repo)
  3. Point a repo at it:  ./install.sh /path/to/repo --vault "$VAULT"
  4. Create a PRIVATE remote and push. Read the vault rules first — nothing
     with personal data, secrets, or credentials belongs in git history.
EOF
